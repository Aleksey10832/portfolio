generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int           @id @default(autoincrement())
  name        String
  description String
  links       ProfileLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model ProfileLink {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id           Int      @id @default(autoincrement())
  company      String
  position     String
  period       String
  achievements String[] @default([])
  profileId    Int
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id            Int           @id @default(autoincrement())
  name          String
  description   String
  repositoryUrl String
  status        ProjectStatus
  profileId     Int
  profile       Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

enum ProjectStatus {
  IN_DEVELOPMENT
  COMPLETED
  PAUSED
  ABANDONED
}
